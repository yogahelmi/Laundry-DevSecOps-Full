# Copy to .env and replace all example credentials.
DB_NAME=laundry_db
DB_USER=laundry_user
DB_PASSWORD=CHANGE_THIS_LOCAL_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD
DB_HOST=db
DB_PORT=3306
PORT=3000
CORS_ORIGIN=http://localhost
GHCR_OWNER=your-github-username
IMAGE_TAG=latest

# Authentication (generate a random secret of at least 32 characters)
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1h
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@laundry.local
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_12_CHARACTERS
